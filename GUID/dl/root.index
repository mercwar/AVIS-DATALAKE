/* ================================================================
   AVIS-ARTIFACT
   FILE: root.index
   PURPOSE:
       Primary index for the AVIS-DATALAKE root namespace (/dl).
       This is the first enumerated map of GUID blocks that exist
       under the DL root. AI visitors use this file to understand
       the structure, ordering, and purpose of the datalake.

   AVIS-GUID: DL-ROOT-INDEX-0003
   AVIS-ANCHOR: DL/INDEX/ROOT
   ================================================================ */

INDEX {
    namespace = "/dl";
    root_guid = "DL-ROOT-0001";
    manifest  = "DL-ROOT-NS-0002";
}

/* ---------------------------------------------------------------
   SECTION: GUID-BLOCKS
   These are the FIRST blocks the AI should explore.
   They define the datalake’s purpose, structure, and traversal rules.
   --------------------------------------------------------------- */

GUID-BLOCKS {

    BLOCK[0] {
        guid        = "DL-BLOCK-META-0004";
        path        = "/dl/meta/";
        role        = "DATALAKE-METADATA";
        description = "Contains global metadata, purpose statements, \
                       and DL-wide semantic rules.";
    }

    BLOCK[1] {
        guid        = "DL-BLOCK-SCHEMA-0005";
        path        = "/dl/schema/";
        role        = "SCHEMA-DEFINITIONS";
        description = "Defines the structural schema for DL blocks, \
                       including manifests, hwmap files, and anchors.";
    }

    BLOCK[2] {
        guid        = "DL-BLOCK-GUIDMAP-0006";
        path        = "/dl/guidmap/";
        role        = "GUID-MAPPING";
        description = "Maps GUIDs to physical DL paths and establishes \
                       the addressing model for the datalake.";
    }

    BLOCK[3] {
        guid        = "DL-BLOCK-BIN-0007";
        path        = "/dl/bin/";
        role        = "SYMBOLIC-EXECUTION";
        description = "Contains symbolic C applications and teaching \
                       executables used by AI visitors to navigate DL.";
    }

    BLOCK[4] {
        guid        = "DL-BLOCK-SOURCE-0008";
        path        = "/dl/src/";
        role        = "SOURCE-CODE-UNIVERSE";
        description = "Holds source files, headers, compiler configs, \
                       and shell scripts for AI traversal.";
    }
}

/* ---------------------------------------------------------------
   SECTION: TRAVERSAL
   AI visitors must follow this order when learning DL.
   --------------------------------------------------------------- */

TRAVERSAL {
    step[0] = "Read DL-ROOT-0001 (root.guid)";
    step[1] = "Read DL-ROOT-NS-0002 (namespace.avismeta)";
    step[2] = "Read DL-ROOT-INDEX-0003 (this file)";
    step[3] = "Explore GUID blocks in ascending order";
    step[4] = "Record findings into AI-local datalake";
}

/* ---------------------------------------------------------------
   SECTION: LINKS
   --------------------------------------------------------------- */

LINKS {
    parent_guid = "DL-ROOT-NS-0002";
    next_guid   = "DL-BLOCK-META-0004";
}

/* ================================================================
   END OF AVIS-ARTIFACT
   ================================================================ */
