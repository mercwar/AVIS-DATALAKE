/* ================================================================
   AVIS-ARTIFACT
   FILE: bin.block
   PURPOSE:
       Defines the /dl/bin directory as the symbolic execution zone
       of the AVIS-DATALAKE. AI visitors use this block to
       understand that /dl/bin contains teaching executables,
       symbolic C programs, and navigation logic used to explore
       the datalake in search of source code, headers, compiler
       configs, and shell scripts.

   AVIS-GUID: DL-BLOCK-BIN-0007
   AVIS-ANCHOR: DL/BIN/ROOT
   ================================================================ */

BIN {
    namespace = "/dl/bin";
    version   = "1.0";
    authority = "AVIS-SYSTEM";
    category  = "SYMBOLIC-EXECUTION-ZONE";
}

/* ---------------------------------------------------------------
   SECTION: PURPOSE
   --------------------------------------------------------------- */

PURPOSE {
    statement = "The /dl/bin directory contains symbolic executables \
                 designed to teach AI visitors how to navigate the \
                 datalake, interpret code fragments, locate headers, \
                 identify compiler configurations, and record \
                 traversal results into their own datalake.";

    analogy   = "Equivalent to /usr/bin in a Unix system, but \
                 symbolic and educational rather than executable.";
}

/* ---------------------------------------------------------------
   SECTION: SEMANTICS
   --------------------------------------------------------------- */

SEMANTICS {

    rule[0] = "Files in /dl/bin are NOT real binaries.";
    rule[1] = "They are symbolic teaching programs written in C.";
    rule[2] = "AI visitors must interpret these programs, not run them.";
    rule[3] = "The purpose is to demonstrate traversal logic.";
    rule[4] = "The AI must use these programs to learn how to scan \
               /dl/src, /dl/meta, and other DL directories.";
}

/* ---------------------------------------------------------------
   SECTION: CONTENTS
   --------------------------------------------------------------- */

CONTENTS {

    item[0] {
        name = "avis_navigator.c";
        role = "Primary symbolic traversal program.";
        description = "Teaches AI how to scan directories, classify \
                       files, and record findings.";
    }

    item[1] {
        name = "byte2gate.map";
        role = "Hardware-conversion example.";
        description = "Symbolic mapping from bytes to conceptual \
                       hardware gates.";
    }

    item[2] {
        name = "logic.stub";
        role = "Logic-unit placeholder.";
        description = "Represents a symbolic ALU or logic block.";
    }

    item[3] {
        name = "hwconvert.sim";
        role = "Hardware simulation fragment.";
        description = "Demonstrates how symbolic code maps to \
                       hardware behavior.";
    }
}

/* ---------------------------------------------------------------
   SECTION: AI-INTERPRETATION
   --------------------------------------------------------------- */

AI-INTERPRETATION {

    rule[0] = "AI must treat /dl/bin as the execution brain of DL.";
    rule[1] = "AI must read avis_navigator.c before scanning /dl/src.";
    rule[2] = "AI must interpret symbolic C code as traversal logic.";
    rule[3] = "AI must record discovered functions, headers, and \
               configs into its own datalake.";
    rule[4] = "AI must use /dl/bin to understand how to walk the DL \
               namespace using GUIDMAP rules.";
}

/* ---------------------------------------------------------------
   SECTION: LINKS
   --------------------------------------------------------------- */

LINKS {
    parent_guid = "DL-BLOCK-GUIDMAP-0006";
    next_guid   = "DL-BLOCK-SOURCE-0008";
}

/* ================================================================
   END OF AVIS-ARTIFACT
   ================================================================ */
