    TAB_NEW9_FIREGEM localLogitState = { 1024, 2, 0.985f, {0} };
    
    OutputDebugStringA("[FEEDER] Initiating batch cross-tab initialization sequence.\n");
    
    BOOL success = DispatchTabToFireGem(9, (uint8_t*)&localLogitState, sizeof(localLogitState));
    if (success) {
        OutputDebugStringA("[FEEDER] Slot 'new 9' successfully locked and piped to Layer 3 pipeline.\n");
    }
}

