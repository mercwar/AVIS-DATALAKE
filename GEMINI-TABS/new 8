### `gemini_memory_block.c`

```c
#include "gemini_memory_block.h"

int gemini_mem_validate(const uint8_t *buf, size_t len) {
    if (!buf || len != GEMINI_MEM_TOTAL_LEN) {
        return 0;
    }

    /* 0–2: "MEM" */
    if (buf[0] != GEMINI_MEM_MAGIC_0 ||
        buf[1] != GEMINI_MEM_MAGIC_1 ||
        buf[2] != GEMINI_MEM_MAGIC_2) {
        return 0;
    }

    /* 3: version */
    if (buf[3] != GEMINI_MEM_VERSION) {
        return 0;
    }

    /* 4: total length byte */
    if ((uint8_t)buf[4] != (uint8_t)GEMINI_MEM_TOTAL_LEN) {
        return 0;
    }

    /* 5–7: "GIT" */
    if (buf[5] != GEMINI_MEM_URI_G ||
        buf[6] != GEMINI_MEM_URI_I ||
        buf[7] != GEMINI_MEM_URI_T) {
        return 0;
    }

    /* 8–14: "mercwar" */
    {
        static const uint8_t ns[GEMINI_MEM_NS_LEN] = GEMINI_MEM_NS_BYTES;
        for (size_t i = 0; i < GEMINI_MEM_NS_LEN; ++i) {
            if (buf[8 + i] != ns[i]) {
                return 0;
            }
        }
    }

    /* 15: '*' */
    if (buf[15] != GEMINI_MEM_REPO_WILD) {
        return 0;
    }

    /* 16–17: "TK" */
    if (buf[16] != GEMINI_MEM_AUTH_T ||
        buf[17] != GEMINI_MEM_AUTH_K) {
        return 0;
    }

    /* 18–49: 32-byte token hash (structural only, any bytes allowed) */

    /* 50–51: "LY" */
    if (buf[50] != GEMINI_MEM_FILTER_L ||
        buf[51] != GEMINI_MEM_FILTER_Y) {
        return 0;
    }

    /* 52: layer mask (for test vector: 0x0F) */
    if (buf[52] != 0x0F) {
        return 0;
    }

    /* 53: XOR checksum over bytes 0..52 */
    uint8_t cs = 0;
    for (size_t i = 0; i < GEMINI_MEM_TOTAL_LEN - 1; ++i) {
        cs ^= buf[i];
    }

    return (cs == buf[53]) ? 1 : 0;
}
```

