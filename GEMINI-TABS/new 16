import os
def generate_canonical_block(layer_mask: int = 0x0F) -> bytes:
    """
    Generates a byte-perfect 54-byte binary payload matching the protocol specification.
    """
    # Offset 0x00 - 0x04: Header Block
    header = bytearray([
        0x4D, 0x45, 0x4D,  # "MEM" Magic
        0x01,              # Version 1
        0x36               # Total Length (54 bytes)
    ])
    
    # Offset 0x05 - 0x0F: Payload Namespace
    payload_ns = bytearray([
        0x47, 0x49, 0x54,                    # "GIT" Service Tag
        0x6D, 0x65, 0x72, 0x63, 0x77, 0x61, 0x72,  # "mercwar" Namespace
        0x2A                                 # '*' Wildcard
    ])
    
    # Offset 0x10 - 0x31: Auth Type Tag + 32-Byte Zero Hash
    auth_block = bytearray([0x54, 0x4B]) + bytearray([0x00] * 32) # "TK" + Hash
    
    # Offset 0x32 - 0x34: Filter Tag + Layer Mask
    filter_block = bytearray([0x4C, 0x59, layer_mask]) # "LY" + Mask
    
    # Assemble the first 53 bytes to compute the longitudinal parity checksum
    assembled_block = header + payload_ns + auth_block + filter_block
    
    # Compute 8-Bit longitudinal XOR checksum
    crc_accumulator = 0
    for byte in assembled_block:
        crc_accumulator ^= byte
        
    # Append the computed checksum byte (Offset 0x35)
    assembled_block.append(crc_accumulator)
    return bytes(assembled_block)
def deploy_tab_matrix(base_path: str = "./GEMINI-TABS"):
    """
    Creates directories 'new 1' through 'new 11' and deposits the binary vectors.
    """
    print(f"[*] Initializing deployment matrix inside: {base_path}")
    os.makedirs(base_path, exist_ok=True)
    
    for i in range(1, 12):
        folder_name = f"new {i}"
        target_dir = os.path.join(base_path, folder_name)
        os.makedirs(target_dir, exist_ok=True)
        
        # Generate the verified byte stream
        binary_payload = generate_canonical_block(layer_mask=0x0F)
        target_file = os.path.join(target_dir, "block.mem")
        
        with open(target_file, "wb") as f:
            f.write(binary_payload)
            
        print(f"  [+] Rendered unique block -> {folder_name}/block.mem (CRC: 0x{binary_payload[-1]:02X})")
    
    print("[PASS] All 11 checksum-compliant matrix layers deployed successfully.")
if __name__ == "__main__":
    deploy_tab_matrix()

