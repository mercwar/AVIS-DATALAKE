## 🛠️ Win32 Memory-Mapped File Directory Monitor (`gemini_tabs_watcher.c`)

This unmanaged engine establishes an asynchronous lock-free directory watch over the `GEMINI-TABS\` directory branch, pulling file system modifications straight into a virtual mapping space.

```c
#include "gemini_tabs_core.h"
#include <strsafe.h>

// Link external feeder dispatch logic
extern BOOL DispatchTabToFireGem(uint32_t tabIndex, const uint8_t* subPayload, size_t subPayloadSize);

#define STATUS_OK          0x00000000
#define STATUS_ERR_OPEN    0xC0000001
#define STATUS_ERR_MAP     0xC0000002
#define STATUS_ERR_INVALID 0xC0000003

/**
 * Parses an ingested .mem file from disk via explicit memory projections
 * and streams it directly to the Layer 3 processing thread.
 */
DWORD ProcessInboundMemFile(const WCHAR* filePath, uint32_t targetTabIndex) {
    // 1. Open target file handle safely with sequential execution optimization
    HANDLE hFile = CreateFileW(
        filePath, 
        GENERIC_READ, 
        FILE_SHARE_READ, 
        NULL, 
        OPEN_EXISTING, 
        FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, 
        NULL
    );
    if (hFile == INVALID_HANDLE_VALUE) return STATUS_ERR_OPEN;

    // 2. Validate file physical footprint matches exactly 54 bytes
    LARGE_INTEGER fileSize;
    if (!GetFileSizeEx(hFile, &fileSize) || fileSize.QuadPart != BLOCK_SIZE) {
        CloseHandle(hFile);
        return STATUS_ERR_INVALID;
    }

    // 3. Create a memory mapped backing projection space
    HANDLE hMap = CreateFileMappingW(hFile, NULL, PAGE_READONLY, 0, 0, NULL);
    if (!hMap) {
        CloseHandle(hFile);
        return STATUS_ERR_MAP;
    }

    // 4. Map the physical storage block onto virtual allocation addresses
    const uint8_t* pBuffer = (const uint8_t*)MapViewOfFile(hMap, FILE_MAP_READ, 0, 0, BLOCK_SIZE);
    if (!pBuffer) {
        CloseHandle(hMap);
        CloseHandle(hFile);
        return STATUS_ERR_MAP;
    }

    // 5. Unpack structural integrity checks out-of-band using invariants
    if (pBuffer[0] != 'M' || pBuffer[1] != 'E' || pBuffer[2] != 'M' || pBuffer[4] != BLOCK_SIZE) {
        UnmapViewOfFile(pBuffer);
        CloseHandle(hMap);
        CloseHandle(hFile);
        return STATUS_ERR_INVALID;
    }

    // 6. Extract the 32-byte specialized sub-payload (token_hash window) 
    // and pipe it straight to the active Fire-Gem interface ring
    const uint8_t* pSubPayload = pBuffer + 0x12; 
    BOOL bRouted = DispatchTabToFireGem(targetTabIndex, pSubPayload, 32);

    // 7. Cleanup descriptors immediately to prevent memory leaks or handle lock drops
    UnmapViewOfFile(pBuffer);
    CloseHandle(hMap);
    CloseHandle(hFile);

    return bRouted ? STATUS_OK : STATUS_ERR_INVALID;
}

/**
 * Active Directory Watcher Worker Thread for real-time tracking of file drops.
 */
DWORD WINAPI GeminiTabsDirectoryWatcher(LPVOID lpParam) {
    WCHAR* targetDirectory = (WCHAR*)lpParam;
    HANDLE hDir = CreateFileW(
        targetDirectory,
        FILE_LIST_DIRECTORY,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
        NULL,
        OPEN_EXISTING,
        FILE_FLAG_BACKUP_SEMANTIC,
        NULL
    );

    if (hDir == INVALID_HANDLE_VALUE) {
        OutputDebugStringA("[WATCHER] [FATAL] Unable to open target directory handle.\n");
        return 1;
    }

    // 64KB aligned buffer to guarantee zero notification loss under high load
    __declspec(align(4)) uint8_t notifyBuffer[65536];
    DWORD bytesReturned = 0;

    OutputDebugStringA("[WATCHER] Non-blocking file-mapping ingestion stream active.\n");

    while (ReadDirectoryChangesW(
        hDir,
        notifyBuffer,
        sizeof(notifyBuffer),
        FALSE, // Monitor local scope layer only
        FILE_NOTIFY_CHANGE_FILE_NAME | FILE_NOTIFY_CHANGE_LAST_WRITE,
        &bytesReturned,
        NULL,
        NULL
    )) {
        uint8_t* pCurrent = notifyBuffer;
        while (pCurrent) {
            FILE_NOTIFY_INFORMATION* pInfo = (FILE_NOTIFY_INFORMATION*)pCurrent;
            
            // Catch complete or modified disk records
            if (pInfo->Action == FILE_ACTION_ADDED || pInfo->Action == FILE_ACTION_MODIFIED) {
                WCHAR relativePath[MAX_PATH] = { 0 };
                StringCchCopyNW(relativePath, MAX_PATH, pInfo->FileName, pInfo->FileNameLength / sizeof(WCHAR));

                // Quick parse routine: Check if file ends with .mem and parse out index number
                WCHAR* extension = wcsrchr(relativePath, L'.');
                if (extension && _wcsicmp(extension, L".mem") == 0) {
                    uint32_t parsedIndex = 0;
                    if (swscanf_s(relativePath, L"new%u.mem", &parsedIndex) == 1) {
                        WCHAR fullPath[MAX_PATH];
                        StringCchPrintfW(fullPath, MAX_PATH, L"%s\\%s", targetDirectory, relativePath);
                        
                        // Fire file tracking map through memory manager
                        ProcessInboundMemFile(fullPath, parsedIndex);
                    }
                }
            }

            if (pInfo->NextEntryOffset == 0) break;
            pCurrent += pInfo->NextEntryOffset;
        }
    }

    CloseHandle(hDir);
    return 0;
}

