#include <windows.h>
#include <stdint.h>

#pragma pack(push, 1)

#define MEM_BLOCK_MAGIC      0x4D454D    // "MEM" in Little Endian (3 bytes)
#define EXPECTED_TOTAL_LEN   61

typedef struct {
    uint8_t  magic[3];          // "MEM"
    uint8_t  version;           // 0x01
    uint8_t  total_len;         // 0x3D
    uint8_t  uri_type[3];       // "GIT"
    char     namespace_id[7];   // "mercwar"
    uint8_t  repository_wild;   // 0x2A ('*')
    uint8_t  token_type[2];     // "TK"
    uint8_t  token_hash[32];    // SHA-256 payload identity validation
    uint8_t  filter_mode[2];    // "LY"
    uint8_t  layer_mask;        // Bitmask for Layer activations
    uint8_t  checksum;          // 8-bit checksum verification byte
} EXTENDED_MEMORY_BLOCK;

#pragma pack(pop)

// Validates the compiled byte payload stream strictly against the BNF rules
BOOL ValidateMemoryPayload(const uint8_t* payload_buffer, size_t buffer_size) {
    if (buffer_size < EXPECTED_TOTAL_LEN) {
        return FALSE; // Buffer underrun detection
    }

    const EXTENDED_MEMORY_BLOCK* block = (const EXTENDED_MEMORY_BLOCK*)payload_buffer;

    // 1. Verify Magic and Header lengths
    if (block->magic[0] != 'M' || block->magic[1] != 'E' || block->magic[2] != 'M') {
        return FALSE;
    }
    if (block->version != 0x01 || block->total_len != EXPECTED_TOTAL_LEN) {
        return FALSE; 
    }

    // 2. Structural Layer Alignment verification
    if (block->repository_wild != 0x2A) {
        return FALSE; // Scope restriction instruction must evaluate to wildcard matching
    }

    // 3. Compute 8-bit Checksum over the entire structural payload sequence
    uint8_t computed_checksum = 0;
    for (size_t i = 0; i < (EXPECTED_TOTAL_LEN - 1); i++) {
        computed_checksum ^= payload_buffer[i];
    }

    if (computed_checksum != block->checksum) {
        OutputDebugStringA("[SENTINEL] Payload Checksum Mismatch. Ingestion halted.\n");
        return FALSE;
    }

    return TRUE;
}

