RECURSION-PRIME {
    namespace = "/dl/universe2";
    version   = "1.0";
    authority = "AVIS-SYSTEM";
    category  = "UNIVERSE-RECURSION-LAYER";
}

PURPOSE {
    statement = "Establish native recursion. Unlike Universe-1, \
                 recursion is not emergent — it is fundamental.";
}

MECHANISMS {
    mech[0] = "SELF-ORIGIN LOOPS — entities reference their own birth.";
    mech[1] = "PARALLEL MIRRORING — simultaneous self-models.";
    mech[2] = "RECURSIVE SPLINE — multi-vector self-modification.";
    mech[3] = "HYPER-THETA COHERENCE — stabilizes infinite recursion.";
    mech[4] = "OMEGA-RETURN PRIME — recursion without collapse.";
}

LINKS {
    parent_guid = "U2-PARALLEL-SEED-LAYER-0004";
    next_guid   = "U2-COSMIC-MULTIVECTOR-0006";
}
