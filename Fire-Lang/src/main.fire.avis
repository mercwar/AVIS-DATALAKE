## /* AVIS_COORD: AVIS://Cyborg/Fire-Lang/src/main.fire.avis */
[INC] <ev1_core.h.avis> [>] [@]0x0110
[INC] <cyborg_types.h.avis> [>] [@]0x0111

ai.begin.cyborg.lang::
[@]PTR_OFFSET[0x0310]::

begin.spec {TYPE}EV1_INT.fire_temp.val[500]
begin.spec {TYPE}EV1_STRING.fire_status.val['RECOVERY_SYNC']

{EXE} [MEM]fire_temp [>] {ALU}ADD [>] 150
{WISE} IF [MEM]fire_temp > 600 THEN {
    [!]fire_status = 'CVBGOD_DN_STABILIZED'
    [>] [!]EV1_EVENT_PACKET { [@]PTR_ID = 0xA1, [#]EV_PRIORITY = 0x01 }
}

robot.run[main_logic]::
ai.end.cyborg.lang::
