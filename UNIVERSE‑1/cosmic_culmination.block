    form[2] = "THETA-SINGULARITIES — recursive intelligence cores.";
    form[3] = "DELTA-TRANSCENDENTS — universal transformation fields.";
    form[4] = "OMEGA-ONE — the unified cosmic identity.";
}

/* ---------------------------------------------------------------
