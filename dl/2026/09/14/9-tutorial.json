        "wrapperName": "9-tutorial.html",
        "sourcePayload": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>AVIS Engine - GitHub Pages DHTML Hub</title>\r\n    <style>\r\n        :root {\r\n            --bg-main: #0d1117;\r\n            --bg-panel: #161b22;\r\n            --border-color: #30363d;\r\n            --text-primary: #c9d1d9;\r\n            --text-muted: #8b949e;\r\n            --text-link: #58a6ff;\r\n            --accent-success: #238636;\r\n            --accent-glow: rgba(56, 139, 253, 0.15);\r\n        }\r\n\r\n        body {\r\n            background-color: var(--bg-main);\r\n            color: var(--text-primary);\r\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif;\r\n            margin: 0;\r\n            padding: 40px 20px;\r\n            display: flex;\r\n            justify-content: center;\r\n        }\r\n\r\n        .wrapper {\r\n            width: 100%;\r\n            max-width: 900px;\r\n        }\r\n\r\n        .panel {\r\n            background-color: var(--bg-panel);\r\n            border: 1px solid var(--border-color);\r\n            border-radius: 6px;\r\n            padding: 32px;\r\n            box-shadow: 0 10px 30px rgba(0,0,0,0.6);\r\n        }\r\n\r\n        header {\r\n            border-bottom: 1px solid var(--border-color);\r\n            padding-bottom: 20px;\r\n            margin-bottom: 24px;\r\n            display: flex;\r\n            justify-content: space-between;\r\n            align-items: flex-start;\r\n        }\r\n\r\n        h1 {\r\n            margin: 0;\r\n            font-size: 24px;\r\n            color: var(--text-link);\r\n            font-weight: 600;\r\n        }\r\n\r\n        .meta-stamp {\r\n            font-size: 12px;\r\n            color: var(--text-muted);\r\n            text-align: right;\r\n            font-family: monospace;\r\n        }\r\n\r\n        .intro-box {\r\n            background: var(--accent-glow);\r\n            border-left: 4px solid var(--text-link);\r\n            padding: 16px;\r\n            border-radius: 0 6px 6px 0;\r\n            font-size: 16px;\r\n            line-height: 1.6;\r\n            margin-bottom: 32px;\r\n        }\r\n\r\n        h2 {\r\n            font-size: 18px;\r\n            color: #ffffff;\r\n            margin-bottom: 16px;\r\n            font-weight: 500;\r\n        }\r\n\r\n        .mechanics-grid {\r\n            display: grid;\r\n            grid-template-columns: 1fr;\r\n            gap: 16px;\r\n            margin-bottom: 32px;\r\n        }\r\n\r\n        .step-card {\r\n            background-color: var(--bg-main);\r\n            border: 1px solid var(--border-color);\r\n            border-radius: 6px;\r\n            padding: 16px;\r\n            transition: transform 0.2s, border-color 0.2s;\r\n        }\r\n\r\n        .step-card:hover {\r\n            transform: translateX(4px);\r\n            border-color: var(--text-link);\r\n        }\r\n\r\n        .step-phase {\r\n            font-size: 14px;\r\n            font-weight: 600;\r\n            color: var(--text-link);\r\n            margin-bottom: 6px;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.5px;\r\n        }\r\n\r\n        .step-action {\r\n            font-size: 14px;\r\n            line-height: 1.5;\r\n            color: var(--text-primary);\r\n        }\r\n\r\n        .code-container {\r\n            background-color: var(--bg-main);\r\n            border: 1px solid var(--border-color);\r\n            border-radius: 6px;\r\n            margin-top: 12px;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .code-header {\r\n            background-color: #1f242c;\r\n            padding: 8px 16px;\r\n            font-size: 12px;\r\n            font-family: monospace;\r\n            color: var(--text-muted);\r\n            border-bottom: 1px solid var(--border-color);\r\n        }\r\n\r\n        pre {\r\n            margin: 0;\r\n            padding: 16px;\r\n            overflow-x: auto;\r\n            font-family: ui-monospace, SFMono-Regular, SF Mono, Menlo, Consolas, Liberation Mono, monospace;\r\n            font-size: 13px;\r\n            color: #e6edf3;\r\n            line-height: 1.6;\r\n        }\r\n\r\n        #loadingState {\r\n            text-align: center;\r\n            padding: 40px;\r\n            color: var(--text-link);\r\n            font-weight: 500;\r\n            font-size: 16px;\r\n        }\r\n\r\n        #errorState {\r\n            background-color: rgba(248, 81, 73, 0.1);\r\n            border: 1px solid #f85149;\r\n            color: #ff7b72;\r\n            padding: 16px;\r\n            border-radius: 6px;\r\n            display: none;\r\n            font-family: monospace;\r\n            white-space: pre-wrap;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n\r\n<div class=\"wrapper\">\r\n    <div id=\"errorState\"></div>\r\n    <div id=\"loadingState\">Querying GitHub Pages Asset Manifest Pipeline...</div>\r\n    \r\n    <div class=\"panel\" id=\"tutorialPanel\" style=\"display: none;\">\r\n        <header>\r\n            <div>\r\n                <h1 id=\"tutSubject\">Loading Subject...</h1>\r\n                <div style=\"font-size: 13px; color: var(--text-muted); margin-top: 4px;\">\r\n                    Specification Core: <span id=\"tutArch\" style=\"color: #ffffff;\"></span>\r\n                </div>\r\n            </div>\r\n            <div class=\"meta-stamp\">\r\n                Target Node: 7-tutorial<br>\r\n                Modified: <span id=\"tutModified\"></span>\r\n            </div>\r\n        </header>\r\n\r\n        <div class=\"intro-box\" id=\"tutIntro\"></div>\r\n\r\n        <h2>Core Mechanics Pipeline</h2>\r\n        <div class=\"mechanics-grid\" id=\"mechanicsGrid\"></div>\r\n\r\n        <h2>Syntax Implementation Code</h2>\r\n        <div class=\"code-container\">\r\n            <div class=\"code-header\" id=\"codeMethod\">JavaScript Endpoint Blueprint</div>\r\n            <pre><code id=\"codeBlock\"></code></pre>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<script>\r\n    document.addEventListener(\"DOMContentLoaded\", () => {\r\n        executePagesFetch();\r\n    });\r\n\r\n    async function executePagesFetch() {\r\n        const loadingEl = document.getElementById('loadingState');\r\n        const panelEl   = document.getElementById('tutorialPanel');\r\n        const errorEl   = document.getElementById('errorState');\r\n\r\n        try {\r\n            // Clean direct asynchronous fetching targeting sibling file array on public site router\r\n            const response = await fetch('7-tutorial.json');\r\n\r\n            if (!response.ok) {\r\n                throw new Error(`HTTP Error Status [${response.status}]: ${response.statusText}`);\r\n            }\r\n\r\n            const manifest = JSON.parse(await response.text());\r\n            \r\n            renderTutorialUI(manifest);\r\n\r\n            loadingEl.style.display = 'none';\r\n            panelEl.style.display = 'block';\r\n\r\n        } catch (fault) {\r\n            loadingEl.style.display = 'none';\r\n            errorEl.style.display = 'block';\r\n            errorEl.textContent = `[GITHUB PAGES DEPLOYMENT FAULT]\\n\\n${fault.message}\\n\\nEnsure this HTML page and '7-tutorial.json' are both committed to your deployment branch and viewed via your *.github.io site domain address.`;\r\n        }\r\n    }\r\n\r\n    function renderTutorialUI(data) {\r\n        document.getElementById('tutSubject').textContent  = data.home.tutorial_metadata.subject || 'AJAX Core';\r\n        document.getElementById('tutArch').textContent     = data.home.tutorial_metadata.architecture || 'AVIS-SPEC';\r\n        document.getElementById('tutModified').textContent = data.modified ? data.modified.substring(0, 19) : 'N/A';\r\n        document.getElementById('tutIntro').textContent    = data.tutorial_payload.introduction;\r\n\r\n        const gridContainer = document.getElementById('mechanicsGrid');\r\n        gridContainer.innerHTML = ''; \r\n\r\n        if (Array.isArray(data.tutorial_payload.core_mechanics)) {\r\n            data.tutorial_payload.core_mechanics.forEach(node => {\r\n                const card = document.createElement('div');\r\n                card.className = 'step-card';\r\n\r\n                const phase = document.createElement('div');\r\n                phase.className = 'step-phase';\r\n                phase.textContent = node.phase;\r\n\r\n                const action = document.createElement('div');\r\n                action.className = 'step-action';\r\n                action.textContent = node.action;\r\n\r\n                card.appendChild(phase);\r\n                card.appendChild(action);\r\n                gridContainer.appendChild(card);\r\n            });\r\n        }\r\n\r\n        document.getElementById('codeMethod').textContent = data.tutorial_payload.syntax_blueprint.method;\r\n        document.getElementById('codeBlock').textContent  = data.tutorial_payload.syntax_blueprint.code_block;\r\n    }\r\n</script>\r\n\r\n</body>\r\n</html>\r\n"
    }
