        "host_node": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>AVIS Telemetry Status</title>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700&family=Rajdhani:wght@500;700&display=swap\" rel=\"stylesheet\">\r\n    \r\n    <style>\r\n        html, body {\r\n            min-height: 100%;\r\n            overflow-y: auto;\r\n            background: rgba(10, 12, 44, 1);\r\n            background-image: radial-gradient(circle at 50% -20%, rgba(12,18,44,1), rgba(2,2,5,1));\r\n            margin: 0;\r\n            padding: 0;\r\n            display: flex;\r\n            flex-direction: column;\r\n            align-items: center;\r\n            justify-content: center;\r\n        }\r\n\r\n        *, *::before, *::after {\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        .status-container {\r\n            margin: 4em auto;\r\n            padding: 2em;\r\n            width: 90%;\r\n            max-width: 600px;\r\n            background: linear-gradient(135deg, rgba(10,11,22,0.9) 0%, rgba(20,25,40,0.85) 100%);\r\n            backdrop-filter: blur(16px);\r\n            -webkit-backdrop-filter: blur(16px);\r\n            border: 1px solid rgba(0,255,255,0.35);\r\n            border-radius: 12px;\r\n            box-shadow: 0 0 25px rgba(0,255,255,0.25), inset 0 0 20px rgba(0,255,255,0.15);\r\n            text-align: center;\r\n            animation: pulseContainer 4s infinite alternate ease-in-out;\r\n        }\r\n\r\n        @keyframes pulseContainer {\r\n            0% { box-shadow: 0 0 25px rgba(0,255,255,0.15), inset 0 0 20px rgba(0,255,255,0.05); }\r\n            100% { box-shadow: 0 0 35px rgba(0,255,255,0.35), inset 0 0 30px rgba(0,255,255,0.25); }\r\n        }\r\n\r\n        h1 {\r\n            font-family: 'Orbitron', sans-serif;\r\n            font-weight: 700;\r\n            font-size: 24px;\r\n            color: #38bdf8;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.15em;\r\n            margin-top: 0;\r\n            margin-bottom: 1.5em;\r\n            text-shadow: 0 0 8px rgba(0,255,255,0.6);\r\n            border-bottom: 1px solid rgba(0,255,255,0.2);\r\n            padding-bottom: 0.5em;\r\n        }\r\n\r\n        .status {\r\n            font-family: 'Rajdhani', sans-serif;\r\n            font-size: 18px;\r\n            font-weight: 700;\r\n            padding: 1.2em;\r\n            border-radius: 6px;\r\n            letter-spacing: 0.05em;\r\n            margin-bottom: 1.5em;\r\n            text-transform: uppercase;\r\n        }\r\n\r\n        /* Success Theme */\r\n        .status.success {\r\n            background: rgba(0, 255, 102, 0.05);\r\n            border: 1px solid rgba(0, 255, 102, 0.4);\r\n            color: #00ff66;\r\n            box-shadow: 0 0 15px rgba(0, 255, 102, 0.2), inset 0 0 10px rgba(0, 255, 102, 0.1);\r\n            text-shadow: 0 0 5px rgba(0, 255, 102, 0.5);\r\n        }\r\n\r\n        /* Error/Failure Theme */\r\n        .status.error, \r\n        .status.failed, \r\n        .status.fail {\r\n            background: rgba(255, 0, 85, 0.05);\r\n            border: 1px solid rgba(255, 0, 85, 0.4);\r\n            color: #ff0055;\r\n            box-shadow: 0 0 15px rgba(255, 0, 85, 0.2), inset 0 0 10px rgba(255, 0, 85, 0.1);\r\n            text-shadow: 0 0 5px rgba(255, 0, 85, 0.5);\r\n        }\r\n\r\n        /* Default/Pending Theme */\r\n        .status:not(.success):not(.error):not(.failed):not(.fail) {\r\n            background: rgba(0, 255, 255, 0.05);\r\n            border: 1px solid rgba(0, 255, 255, 0.4);\r\n            color: #00ffff;\r\n            box-shadow: 0 0 15px rgba(0, 255, 255, 0.2), inset 0 0 10px rgba(0, 255, 255, 0.1);\r\n        }\r\n\r\n        .btn-return {\r\n            display: inline-block;\r\n            background: linear-gradient(90deg, rgba(0,255,255,0.8), rgba(56,189,248,0.8));\r\n            color: #020205;\r\n            padding: 0.8em 2em;\r\n            text-decoration: none;\r\n            border-radius: 4px;\r\n            font-family: 'Orbitron', sans-serif;\r\n            font-weight: 700;\r\n            font-size: 12px;\r\n            letter-spacing: 0.1em;\r\n            text-transform: uppercase;\r\n            transition: all 0.3s ease;\r\n            box-shadow: 0 0 10px rgba(0,255,255,0.3);\r\n        }\r\n\r\n        .btn-return:hover {\r\n            background: linear-gradient(90deg, rgba(56,189,248,1), rgba(0,255,255,1));\r\n            box-shadow: 0 0 20px #00ffff, 0 0 30px rgba(56,189,248,0.6);\r\n            transform: translateY(-2px);\r\n            color: #000;\r\n        }\r\n\r\n        footer {\r\n            margin-top: auto;\r\n            width: 100%;\r\n            padding: 1.5em 1em;\r\n            background: linear-gradient(180deg, rgba(10,11,22,0.9) 0%, rgba(5,6,12,0.98) 100%);\r\n            border-top: 1px solid rgba(0, 255, 255, 0.25);\r\n            text-align: center;\r\n            font-family: 'Orbitron', sans-serif;\r\n            font-size: 11px;\r\n            font-weight: 700;\r\n            color: #38bdf8;\r\n            letter-spacing: 0.25em;\r\n            text-transform: uppercase;\r\n            opacity: 0.7;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"status-container\">\r\n        \r\n    </div>\r\n\r\n    <footer>\r\n        AVIS DATALAKE SYSTEM\r\n    </footer>\r\n</body>\r\n</html>",
