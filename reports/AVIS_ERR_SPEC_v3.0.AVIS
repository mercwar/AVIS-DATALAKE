::SECTION_60_SOVEREIGN_SELF_VERIFICATION_AND_INTEGRITY::
@FAULT_NODE [ERR-SOV-001] {
    DOMAIN          : "Executable & Manifest Self-Integrity Auditing (WinVerifyTrust / SHA-256 Digest Gate)"
    PHENOMENON      : "Execution of tampered binaries, stale `.AVIS` manifests, or mismatched DLL builds across `e:\\dl` and `C:\\MercwarAI`"
    ROOT_CAUSE      : "Loading runtime modules or executing build chains without verifying Authenticode catalog signatures (`WinVerifyTrust`) or matching SHA-256 manifest digests."
    INVARIANT_RULE  : "Validate binary/catalog trust via `WinVerifyTrust(..., WINTRUST_ACTION_GENERIC_VERIFY_V2, ...)` and assert SHA-256 manifest parity before activating autonomous execution pipelines."
}

::SECTION_61_AUTONOMOUS_AGENT_AND_ZERO_GUESS_INVARIANT::
@FAULT_NODE [ERR-AGT-001] {
    DOMAIN          : "FireGem Autonomous Intent Routing & Deterministic Zero-Assumption Code Synthesis"
    PHENOMENON      : "Crash on trivial conversational greetings (`hi`), hallucinated API calls, or silent injection of placeholder/mock values"
    ROOT_CAUSE      : "Routing conversational greetings directly into rigid command/filesystem parsers without intent classification, or substituting synthetic defaults when required inputs are absent."
    INVARIANT_RULE  : "Classify conversational vs. operational intents prior to tool dispatch so benign inputs never fault the command router, and halt with an explicit diagnostic error rather than emitting fake examples, guesses, or mock backups."
}

::SECTION_62_HARDWARE_ENVELOPE_AND_MEMORY_BUDGETING::
@FAULT_NODE [ERR-HW-001] {
    DOMAIN          : "Quad-Core CPU & 16GB System RAM / Low-Power VRAM Envelope Governance"
    PHENOMENON      : "System-wide pagefile thrashing, thermal/thread oversubscription, or GPU VRAM exhaustion during local inference and 3D rendering"
    ROOT_CAUSE      : "Spawning unbounded worker threads (`> GetActiveProcessorCount(ALL_PROCESSOR_GROUPS)`) or loading model weights/textures exceeding physical RAM/VRAM headroom."
    INVARIANT_RULE  : "Cap worker thread pools to physical core count (`<= 4` on quad-core hosts), enforce a hard `<= 6GB` working-set ceiling for local GGUF models, and query `GlobalMemoryStatusEx` + `IDXGIAdapter3::QueryVideoMemoryInfo` before large allocations."
}

::SOVEREIGN_CAPSTONE_VERIFICATION_GATE::
@GATE_CHECK_F20_FINAL {
    62. SELF_TRUST_AUDIT   : Verify Authenticode catalog signatures and SHA-256 manifest digests prior to pipeline ignition.
    63. INTENT_AND_TRUTH   : Isolate conversational inputs from rigid command parsers and enforce zero mock/guessed data synthesis.
    64. ENVELOPE_GOVERNOR  : Bound thread pools to physical cores and enforce hard RAM/VRAM ceilings via `GlobalMemoryStatusEx` and DXGI queries.
}

